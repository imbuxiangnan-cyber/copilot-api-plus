{
  "name": "copilot-api-plus",
  "version": "1.7.27",
  "description": "Turn GitHub Copilot into OpenAI/Anthropic API compatible server. Features: smart model matching, API key auth, and more.",
  "keywords": [
    "proxy",
    "github-copilot",
    "openai-compatible",
    "anthropic-compatible",
    "claude-code"
  ],
  "homepage": "https://github.com/imbuxiangnan-cyber/copilot-api-plus",
  "bugs": "https://github.com/imbuxiangnan-cyber/copilot-api-plus/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imbuxiangnan-cyber/copilot-api-plus.git"
  },
  "license": "MIT",
  "author": "imbuxiangnan-cyber",
  "type": "module",
  "bin": {
    "copilot-api-plus": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "bun run --watch ./src/main.ts start",
    "knip": "knip-bun",
    "lint": "eslint --cache",
    "lint:all": "eslint --cache .",
    "prepack": "bun run build",
    "prepare": "bunx simple-git-hooks || true",
    "release": "bumpp && bun publish --access public",
    "start": "NODE_ENV=production bun run ./src/main.ts start",
    "test": "bun test",
    "typecheck": "tsc"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*": "bun run lint --fix"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "citty": "^0.1.6",
    "clipboardy": "^5.3.2",
    "consola": "^3.4.2",
    "dotenv": "^17.4.2",
    "fetch-event-stream": "^0.1.6",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.13.13",
    "proxy-from-env": "^1.1.0",
    "srvx": "^1.0.5",
    "tiny-invariant": "^1.3.3",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@echristian/eslint-config": "^0.0.54",
    "@types/bun": "^1.4.3",
    "@types/proxy-from-env": "^1.0.4",
    "bumpp": "^10.4.1",
    "eslint": "^9.39.5",
    "knip": "^6.41.0",
    "lint-staged": "^16.4.0",
    "prettier-plugin-packagejson": "^2.5.22",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.15.12",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=20.18.1"
  }
}
