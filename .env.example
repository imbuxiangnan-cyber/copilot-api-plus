# Optional Docker Compose settings. Copy to .env and keep credentials local.
# The host port is bound to 127.0.0.1 by compose.yaml.
COPILOT_API_PORT=4141

# Optional: the Docker entrypoint reads GH_TOKEN. Leave empty to use device login.
# Source/CLI users should run `bun src/main.ts auth` or pass --github-token.
GH_TOKEN=

# Optional proxy settings. Inside Docker, a host proxy normally uses
# http://host.docker.internal:7890 rather than http://127.0.0.1:7890.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# Optional GitHub Enterprise URLs. Empty values use public GitHub.
GITHUB_BASE_URL=
GITHUB_API_BASE_URL=

# Optional: disable the proxy's additional system-prompt override.
# COPILOT_API_OVERRIDE=off
